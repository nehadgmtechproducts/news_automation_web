# Copy to deploy/.env and fill in. This file holds no secrets, but .env is git-ignored anyway.

# Your domain, no https://. Its DNS "A" record must point at this server before you start.
SITE_DOMAIN=thebrief.example.com
# The same domain with https:// in front. Used for canonical links, link previews and the sitemap,
# and it is baked in when the site is built: change it, then run `docker compose up -d --build`.
SITE_URL=https://thebrief.example.com

# Folder shared with the backend. The backend writes approved stories into it; the site reads them.
# It must contain content/articles/ and public/media/ (see deploy/README.md).
# Use the SAME path as WEB_PROJECT_HOST_DIR in the backend's .env.
SITE_DATA_DIR=/srv/news/site-data

# Footer: how readers reach you, and your real profile pages (an icon shows only if its URL is set).
CONTACT_EMAIL=
# The Resident Grievance Officer named on /legal-compliance (required of a news publisher by the IT Rules, 2021).
# A real person with a real mailbox; leave all three out and the page names nobody.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_ADDRESS=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_LINKEDIN=
SOCIAL_X=

# Videos stay hidden while the backend makes text + images only.
SHOW_VIDEOS=false
