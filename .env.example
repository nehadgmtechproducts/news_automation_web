# Public origin of the site, no path. Drives canonical URLs, Open Graph, sitemap and JSON-LD.
SITE_URL=http://localhost:3000

# Where anonymous read counts for "Most read today" are stored (a small JSON file).
# Needs a persistent disk; on serverless hosting swap FileReadStore for a database/Redis one.
READS_FILE=.data/reads.json

# Where newsletter sign-ups are stored (a JSON file of email addresses; keep it private).
SUBSCRIBERS_FILE=.data/subscribers.json

# Footer / policies. Set before launch.
# CONTACT_EMAIL is how readers reach you (corrections, privacy requests); "Contact Us" shows only when set.
CONTACT_EMAIL=
# Real profile URLs; each icon in the footer shows only if its URL is set.
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_LINKEDIN=
SOCIAL_X=

# Videos are hidden by default (articles are text + images). Set to true to show the player,
# the Watch page and the video links again. The video files and data are kept either way.
SHOW_VIDEOS=false
